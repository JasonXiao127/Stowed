# Copy to .env and adjust.
#
# UID/GID the container runs as. Use the SAME values as your *arr stack
# (Sonarr/Radarr/etc. default to 1000:1000) so downloaded files match your
# media-folder permissions. Host folders must be owned by this uid:gid:
#   mkdir -p downloads config && chown -R 1000:1000 downloads config
PUID=1000
PGID=1000

# The web UI port is configured in docker-compose.yml (look for the
# "x-stow-port: &stow_port" anchor near the top of the svc). It defaults to
# 5183 -> http://<machine-ip>:5183. The node server also falls back to STOW_PORT
# if you run it outside Docker; leave it unset here to use that default.

# yt-dlp is always the latest nightly build (YouTube changes break old stable
# yt-dlp builds; the nightly carries the newest player-client fixes).
# Rebuild with: docker compose build --no-cache stow   # to fetch a newer nightly

# Optional: shared secret required by all API/WebSocket requests.
# Leave unset (blank) for a trusted LAN. Example: STOW_API_KEY=hunter2
# When set, enter the key in the web UI's "API key" field (bottom bar) to enable
# the bundled client; or send it as X-API-Key / Authorization: Bearer.
# STOW_API_KEY=

# Optional: hostnames (optionally "host:port") allowed to reach the API and
# WebSocket. Loopback and IP-literal access always works. Add entries ONLY if
# you open Stow via a hostname, e.g. http://media-pc:5183 -> "media-pc:5183".
# This is the DNS-rebinding defense: the Host header must match an allowed name.
# STOW_ALLOWED_HOSTS=media-pc:5183

# Optional: SSRF guard. Stow must fetch URLs to download from them; by default
# it refuses URLs whose literal target is a loopback/private/link-local address
# (cloud metadata, routers, LAN hosts). Set to 1 if you intentionally download
# from other machines on your network.
# STOW_ALLOW_PRIVATE_IP_URLS=1

# Optional: resource limits (Docker image / node defaults in parentheses).
# STOW_MAX_QUEUE=500
# STOW_MAX_URLS_PER_REQUEST=100
# STOW_MAX_WS_PER_IP=32        # max WebSocket connections per client IP; 0 = unlimited