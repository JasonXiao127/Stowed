{
  "name": "stowed-web",
  "version": "1.0.0",
  "description": "Stowed Web - YouTube Audio Downloader & Tagger web service (Docker)",
  "main": "server/index.js",
  "scripts": {
    "build": "vite build --config vite.web.config.mjs",
    "build:web": "vite build --config vite.web.config.mjs",
    "start": "node server/index.js",
    "start:server": "node server/index.js",
    "dev:server": "cross-env NODE_ENV=development node server/index.js",
    "dev:web": "vite --config vite.web.config.mjs",
    "test": "node --test server/downloader.test.js server/security.test.js server/musicbrainz.test.js server/trim.test.js server/routes.test.js server/metadata.test.js server/hardening.test.js",
    "setup-binaries": "node scripts/download-binaries.js"
  },
  "keywords": [],
  "author": "Stow",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "cross-env": "^7.0.3",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@stowed/core": "*",
    "@stowed/shared-ui": "*",
    "adm-zip": "^0.6.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wavesurfer.js": "^7.10.1",
    "ws": "^8.18.0"
  }
}
